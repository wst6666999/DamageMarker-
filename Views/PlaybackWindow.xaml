<Window
    x:Class="DamageMarker.Views.PlaybackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PlaybackWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Canvas.LayoutTransform>
            <ScaleTransform x:Name="Scal" />
        </Canvas.LayoutTransform>

        <!-- 红框：真正截图范围 -->
        <Border
            x:Name="selectionBorder"
            BorderBrush="Red"
            BorderThickness="4">
            <Grid Background="Transparent">
                <Button
                    Name="CloseButton"
                    Width="22"
                    Height="22"
                    Margin="0,-15,-15,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Command="hc:ControlCommands.CloseWindow"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    Foreground="White"
                    Style="{StaticResource ButtonIcon}" />
            </Grid>
        </Border>

        <!-- 蓝框：OCR里程识别提示区域，和红框同级，便于使用绝对坐标控制 -->
        <Rectangle
            x:Name="MileageBorder"
            Fill="Transparent"
            Stroke="Blue"
            StrokeThickness="1" />

        <TextBlock
            x:Name="TipText"
            FontSize="24"
            Foreground="Red"
            Text="回放过程中请勿按左右按键,并且保证里程在蓝框内" />
    </Canvas>
</Window>
