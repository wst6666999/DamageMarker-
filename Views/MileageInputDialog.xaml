<Border
    x:Class="DamageMaker.Views.MileageInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:vm="clr-namespace:DamageMarker.ViewModels"
    Width="300"
    Height="150"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10">
    
    

    <StackPanel Margin="20">
        <TextBlock Text="请输入当前里程数：" Margin="0,0,0,10"/>
        <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="70" Margin="0,0,10,0" Command="{Binding ConfirmCommand}"/>
            <Button Content="取消" Width="70" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Border>