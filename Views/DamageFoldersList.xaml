<Window
    x:Class="DamageMaker.Views.DamageFoldersList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DamageMaker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DamageMaker.ViewModels"
    x:Name="FoldersDataGrid"
    
    Title="DamageFoldersList"
    Width="1400"
    Height="650"
    d:DataContext="{d:DesignInstance Type=vm:DamageFoldersListViewModel}"
    mc:Ignorable="d">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="1" Color="#FFF5F5F5" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <!--  DataGrid 样式  -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="35" />
            <Setter Property="ColumnHeaderHeight" Value="50" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AlternatingRowBackground" Value="#FFF5F5F5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFB0BEC5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!--  DataGrid 表头样式  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#326cf3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF01579B" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <!--  单元格内容居中  -->
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  按钮样式  -->
        <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="Width" Value="250" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />

        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="965*"/>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="369*"/>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid
            x:Name="folderList"
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding DamageFolders}"
            ScrollViewer.VerticalScrollBarVisibility="Visible"
            
            SelectedIndex="{Binding SelectedIndex}"
            SelectionChanged="folderList_SelectionChanged"
            SelectionMode="Extended" Grid.ColumnSpan="6" Margin="0,0,0,58" Grid.RowSpan="2">
            <DataGrid.RowHeaderTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                </DataTemplate>
            </DataGrid.RowHeaderTemplate>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding DoubleClickDamageFolderCommand}" CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding SerialNumber}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="序号"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="300"
                    Binding="{Binding FolderName}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="文件名"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding HasDamage, Converter={StaticResource Boolean2StringConverter}, ConverterParameter='否;是'}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="是否有伤损数据"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding CreatTime}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="创建日期"
                    IsReadOnly="True"
                    SortDirection="Descending" />
                <DataGridTextColumn
                    Binding="{Binding PngCount}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="捕获图片数量"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding DamagePngCount}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="伤损图片数量"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding HasDocx, Converter={StaticResource Boolean2StringConverter}, ConverterParameter='否;是'}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="是否有报表数据"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding HasFolderInfo, Converter={StaticResource Boolean2StringConverter}, ConverterParameter='否;是'}"
                    IsReadOnly="{Binding  DataContext.HasFolderInfo,ElementName=folderList}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    Header="是否有文件信息数据"
                    />
                <DataGridTextColumn
                    Header="备注"
                    IsReadOnly="False"
                    Binding="{Binding Remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    ElementStyle="{StaticResource CenterCellStyle}"
                    />
            </DataGrid.Columns>
        </DataGrid>

        <UniformGrid
            Grid.Row="1"
            Margin="10,10,5,10"
            Columns="5" Grid.ColumnSpan="5">
            <Button
                Command="{Binding OpenDocxCommand}"
                CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}"
                Content="打开Word报告" />
            <Button Command="{Binding ExportExcelCommand}" Content="导出Excel" />
            <Button
                Command="{Binding DeleteFoldersCommand}"
                CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}"
                Content="删除选中项" />
            <Button
                Command="{Binding OpenInFolderCommand}"
                CommandParameter="in文件夹"
                Content="打开In根目录" />
            <Button
                Command="{Binding OpenInFolderCommand}"
                CommandParameter="Excel文件夹"
                Content="打开Excel目录" />
        </UniformGrid>
        <hc:SearchBar 
            HorizontalAlignment="Left" 
            Margin="228,10,0,0" 
            VerticalAlignment="Top" 
            Width="129"
            hc:InfoElement.TitlePlacement="Left"
            hc:InfoElement.TitleWidth="12"
            Command="{Binding SearchHistoricalFileCommand}"
            CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
            Style="{StaticResource SearchBarPlus}"
            Text="{Binding SearchHistoricalFileText}" Grid.Column="3" 
           />
    </Grid>
</Window>
