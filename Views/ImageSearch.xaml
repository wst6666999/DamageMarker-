<Window x:Class="DamageMaker.Views.ImageSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:DamageMaker.Views"
        xmlns:converters="clr-namespace:DamageMaker.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:viewmodels="clr-namespace:DamageMaker.ViewModels"
        Title="周期对比"
        Width="1400"
        Height="795"
        d:DataContext="{d:DesignInstance Type=viewmodels:ImageSearchViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:CategoryConverter x:Key="CategoryConverter"/>

        <Style x:Key="SearchBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF0F8FF"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10,10,10,15"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFB0E0E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CompareBorderStyle" TargetType="Border" BasedOn="{StaticResource SearchBorderStyle}">
            <Setter Property="Background" Value="#FFF1F8E9"/>
            <Setter Property="BorderBrush" Value="#FFC5E1A5"/>
        </Style>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,5,0"/>
            <Setter Property="Foreground" Value="#FF2C3E50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CompareLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FilterLabelStyle}">
            <Setter Property="Foreground" Value="#FF33691E"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="Margin" Value="15,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF29B6F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0288D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompareButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF43A047"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFF44336"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE53935"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFC62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="180"/>
            <Setter Property="ColumnHeaderHeight" Value="45"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF9F9F9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="CurrentPeriodDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="BorderBrush" Value="#FF4FC3F7"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="ComparePeriodDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="BorderBrush" Value="#FF4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#FF4FC3F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="CompareColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}">
            <Setter Property="Background" Value="#FF4CAF50"/>
        </Style>
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFB0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImagePreviewStyle" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource SearchBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="线别:" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox
                    Width="110"
                    Style="{StaticResource ModernTextBox}"
                    Text="{Binding SelectedLineType, Mode=OneWay}"
                    IsReadOnly="True"
                    Focusable="False"
                    Background="#FFF5F5F5"/>

                <TextBlock Text="上下行:" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox
                    Width="110"
                    Style="{StaticResource ModernTextBox}"
                    Text="{Binding SelectedLineDirection, Mode=OneWay}"
                    IsReadOnly="True"
                    Focusable="False"
                    Background="#FFF5F5F5"/>

                <TextBlock Text="左右股:" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox
                    Width="110"
                    Style="{StaticResource ModernTextBox}"
                    Text="{Binding SelectedRailType, Mode=OneWay}"
                    IsReadOnly="True"
                    Focusable="False"
                    Background="#FFF5F5F5"/>

                <TextBlock Text="类别:" Style="{StaticResource FilterLabelStyle}"/>
                <ComboBox 
                    Width="90"
                    ItemsSource="{Binding WeldTypes}"
                    SelectedItem="{Binding SelectedWeldType}"
                    Height="36" 
                    Margin="8,0" 
                    FontSize="14" 
                    Padding="8,0"
                    Background="White" 
                    BorderBrush="#FFB0BEC5" 
                    BorderThickness="1"
                    VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBlock Text="里程:" Style="{StaticResource FilterLabelStyle}"/>
                <TextBox 
                    Width="110" 
                    Style="{StaticResource ModernTextBox}" 
                    Text="{Binding MileageFilter}"/>

                <Button 
                    Content="搜索" 
                    Command="{Binding SearchCommand}" 
                    Style="{StaticResource ActionButtonStyle}"
                    Width="100" 
                    Height="40"/>
                <Button 
                    Content="重置" 
                    Command="{Binding ResetSearchCommand}" 
                    Style="{StaticResource ActionButtonStyle}"
                    Width="100" 
                    Height="40"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CompareBorderStyle}" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="周期对比设置" FontSize="16" FontWeight="Bold" Foreground="#FF33691E" Margin="0,0,15,0"/>

                <TextBlock Text="对比周期:" Style="{StaticResource CompareLabelStyle}"/>
                <ComboBox 
                    Width="120"
                    ItemsSource="{Binding AvailablePeriods}"
                    SelectedItem="{Binding SelectedComparePeriod}"
                    Height="36" 
                    Margin="8,0" 
                    FontSize="14" 
                    Padding="8,0"
                    Background="White" 
                    BorderBrush="#FF81C784" 
                    BorderThickness="1"
                    VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBlock Text="对比日期:" Style="{StaticResource CompareLabelStyle}"/>
                <ComboBox
                    Width="140"
                    ItemsSource="{Binding AvailableCompareDates}"
                    SelectedItem="{Binding SelectedCompareDate}"
                    Height="36"
                    Margin="8,0"
                    FontSize="14"
                    Background="White"
                    BorderBrush="#FF81C784"
                    BorderThickness="1"
                    VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='yyyy-MM-dd'}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button 
                    Content="开始对比" 
                    Command="{Binding StartCompareCommand}" 
                    Style="{StaticResource CompareButtonStyle}"
                    Width="120" 
                    Height="40"
                    Margin="20,0,0,0"/>

                <Button 
                    Content="清除对比" 
                    Command="{Binding ClearCompareCommand}" 
                    Style="{StaticResource ActionButtonStyle}"
                    Width="100" 
                    Height="40"
                    Margin="10,0,0,0"/>

                <TextBlock Text="{Binding CompareStatus}" 
                           Margin="20,0,0,0" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           Foreground="#FF4CAF50"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#FFE3F2FD">
                    <TextBlock Text="当前周期数据" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding CurrentPeriodInfo}" 
                               Margin="20,0,0,0" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               Foreground="#FF0288D1"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <DataGrid
                    x:Name="currentPeriodList"
                    Grid.Row="1"
                    Style="{StaticResource CurrentPeriodDataGridStyle}"
                    ItemsSource="{Binding CurrentPeriodResults}"
                    SelectedIndex="{Binding SelectedIndex}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowHeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=DataGridRow}}" 
                                      Margin="10,0,0,0"/>
                        </DataTemplate>
                    </DataGrid.RowHeaderTemplate>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding DoubleClickImageCommand}" CommandParameter="{Binding ElementName=currentPeriodList, Path=SelectedItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Mileage}"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="里程"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="150"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="类别"
                            IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="DamageType" Converter="{StaticResource CategoryConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="250" Header="当前图片">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF0F8FF" CornerRadius="8" Margin="4" 
                                        BorderBrush="#FFB0E0E6" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="当前图" FontSize="12" Foreground="#FF0288D1" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <Image Source="{Binding ImgData}" 
                                                Width="220" 
                                                Height="130" 
                                                Style="{StaticResource ImagePreviewStyle}"
                                                ToolTip="双击查看大图"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding SaveTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="保存时间"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="100" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        Content="删除" 
                                        Command="{Binding DataContext.DeleteSingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        ToolTip="删除此图片"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Column="1" Background="#FFE0E0E0" Width="1"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#FFE8F5E8" >
                    <TextBlock Text="对比周期数据" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding ComparePeriodInfo}" 
                               Margin="20,0,0,0" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               Foreground="#FF2E7D32"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <DataGrid
                    x:Name="comparePeriodList"
                    Grid.Row="1"
                    Style="{StaticResource ComparePeriodDataGridStyle}"
                    ItemsSource="{Binding ComparePeriodResults}"
                    SelectedIndex="{Binding CompareSelectedIndex}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompareColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowHeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=DataGridRow}}" 
                                      Margin="10,0,0,0"/>
                        </DataTemplate>
                    </DataGrid.RowHeaderTemplate>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding DoubleClickCompareImageCommand}" CommandParameter="{Binding ElementName=comparePeriodList, Path=SelectedItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Mileage}"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="里程"
                            IsReadOnly="True" />

                        <DataGridTextColumn
                            Width="150"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="类别"
                            IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Path="DamageType" Converter="{StaticResource CategoryConverter}"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="250" Header="对比图片">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF1F8E9" CornerRadius="8" Margin="4" 
                                        BorderBrush="#FFC5E1A5" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="对比图" FontSize="12" Foreground="#FF2E7D32" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <Image Source="{Binding ImgData}" 
                                                Width="220" 
                                                Height="130" 
                                                Style="{StaticResource ImagePreviewStyle}"
                                                ToolTip="双击查看大图"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding SaveTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource CenterCellStyle}"
                            Header="保存时间"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Width="100" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button 
                                        Content="查看" 
                                        Command="{Binding DataContext.ViewCompareImageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CompareButtonStyle}"
                                        ToolTip="查看对比图片"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <StatusBar Grid.Row="3" Background="#FFE3F2FD" Padding="10">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentPeriodResults.Count, StringFormat='当前周期: {0} 组数据'}" 
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding ComparePeriodResults.Count, StringFormat='对比周期: {0} 组数据'}" 
                               FontSize="14" FontWeight="SemiBold" Foreground="#FF2E7D32"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CompareInfo}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#FF4CAF50"
                               Margin="0,0,15,0"/>
                    <TextBlock Text="双击图片可查看大图" 
                               FontSize="14" 
                               FontStyle="Italic" 
                               Foreground="#FF607D8B"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>