<Window x:Class="DamageMaker.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 当前周期图片区域 -->
            <Border Grid.Column="0" 
                    Margin="10" 
                    BorderBrush="LightGray" 
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <!-- 标题栏 -->
                    <Border DockPanel.Dock="Top" 
                            Background="#F5F5F5" 
                            Height="40"
                            Padding="10,0">
                        <Grid>
                            <TextBlock x:Name="txtCurrentTitle" 
                                       Text="当前周期" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="14" 
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- 图片区域 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 图片显示区域 - 使用Grid替代Canvas -->
                        <Border Grid.Row="0" 
                                Padding="10"
                                Background="White">
                            <Grid x:Name="currentImageContainer" 
                                  Background="White"
                                  ClipToBounds="True">
                                <Image x:Name="imgCurrentPreview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"
                                       MouseMove="Image_MouseMove">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="currentTranslateTransform"/>
                                            <ScaleTransform x:Name="currentScaleTransform"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- 图片切换控件 -->
                        <Border Grid.Row="1" 
                                Background="#F9F9F9" 
                                Padding="10">
                            <StackPanel x:Name="currentImageControls"
                                       Orientation="Horizontal" 
                                       HorizontalAlignment="Center"
                                       Visibility="Visible">
                                <Button x:Name="btnPrevCurrent" 
                                        Content="上一张" 
                                        Width="80"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Click="BtnPrevCurrent_Click"/>
                                <TextBlock x:Name="txtCurrentPage" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           FontSize="14"/>
                                <Button x:Name="btnNextCurrent" 
                                        Content="下一张" 
                                        Width="80"
                                        Height="30"
                                        Click="BtnNextCurrent_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 分隔线 -->
            <Rectangle Grid.Column="1" Fill="LightGray" Width="1"/>

            <!-- 对比周期图片区域 -->
            <Border Grid.Column="2" 
                    Margin="10" 
                    BorderBrush="LightGray" 
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <!-- 标题栏 -->
                    <Border DockPanel.Dock="Top" 
                            Background="#F5F5F5" 
                            Height="40"
                            Padding="10,0">
                        <Grid>
                            <TextBlock x:Name="txtCompareTitle" 
                                       Text="对比周期" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="14" 
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- 图片区域 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 图片显示区域 - 使用Grid替代Canvas -->
                        <Border Grid.Row="0" 
                                Padding="10"
                                Background="White">
                            <Grid x:Name="compareImageContainer" 
                                  Background="White"
                                  ClipToBounds="True">
                                <Image x:Name="imgComparePreview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                       MouseLeftButtonUp="Image_MouseLeftButtonUp"
                                       MouseMove="Image_MouseMove">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="compareTranslateTransform"/>
                                            <ScaleTransform x:Name="compareScaleTransform"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- 图片切换控件 -->
                        <Border Grid.Row="1" 
                                Background="#F9F9F9" 
                                Padding="10">
                            <StackPanel x:Name="compareImageControls"
                                       Orientation="Horizontal" 
                                       HorizontalAlignment="Center"
                                       Visibility="Visible">
                                <Button x:Name="btnPrevCompare" 
                                        Content="上一张" 
                                        Width="80"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Click="BtnPrevCompare_Click"/>
                                <TextBlock x:Name="txtComparePage" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           FontSize="14"/>
                                <Button x:Name="btnNextCompare" 
                                        Content="下一张" 
                                        Width="80"
                                        Height="30"
                                        Click="BtnNextCompare_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" 
                Background="#F0F0F0" 
                Padding="10">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="缩放控制：" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontSize="14"/>
                <Slider x:Name="sliderZoom"
                        Minimum="0.1"
                        Maximum="3" 
                        Value="1.0"
                        Width="300"
                        Height="30"/>
                <TextBlock x:Name="txtZoomLevel" 
                           Text="100%" 
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="14"
                           MinWidth="50"/>
                <!-- 添加重置缩放按钮 -->
                <Button x:Name="btnResetZoom"
                        Content="重置缩放"
                        Width="80"
                        Height="30"
                        Margin="20,0,10,0"
                        Click="BtnResetZoom_Click"/>
                <!-- 添加重置位置按钮 -->
                <Button x:Name="btnResetPosition"
                        Content="重置位置"
                        Width="80"
                        Height="30"
                        Margin="10,0,0,0"
                        Click="BtnResetPosition_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>