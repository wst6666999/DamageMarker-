<UserControl x:Class="DamageMaker.Views.DamageDisplayBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DamageMarker.Views"
             xmlns:props="clr-namespace:DamageMaker.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 创建Settings.Default的静态绑定源 -->
        <props:Settings x:Key="SettingsSource"/>
    </UserControl.Resources>
    <Grid>
        <!-- 原始图像 -->
        <Image x:Name="BaseImage" Stretch="Fill"/>

        <!-- 标记覆盖层 -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- 这里会动态添加标记元素 -->
        </Canvas>

        <!-- 参考线 -->
        <Canvas x:Name="GuideLineCanvas" IsHitTestVisible="False">
            <Line x:Name="LeftGuideLine" Stroke="Red" StrokeDashArray="2 2" StrokeThickness="2"
                  Visibility="Collapsed"/>
            <Line x:Name="RightGuideLine" Stroke="Red" StrokeDashArray="2 2" StrokeThickness="2"
                  Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</UserControl>