<Window
    x:Class="DamageMarker.Views.PlaybackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PlaybackWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel.LayoutTransform>
            <ScaleTransform x:Name="Scal" />
        </StackPanel.LayoutTransform>
        <Border
            x:Name="selectionBorder"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            BorderBrush="Red"
            BorderThickness="4">
            <!--  边框是向内占用空间的  -->
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Button
                    Name="CloseButton"
                    Width="22"
                    Height="22"
                    Margin="0,-15,-15,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    hc:IconElement.Geometry="{StaticResource ErrorGeometry}"
                    Command="hc:ControlCommands.CloseWindow"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    Foreground="White"
                    Grid.Row="0"
                    Style="{StaticResource ButtonIcon}"
                    />
                <Rectangle
                    x:Name="MileageBorder"
                    Grid.Row="1"
                    Height="45"
                    VerticalAlignment="Bottom"
                    Fill="Transparent"
                    Stroke="Blue"
                    StrokeThickness="1" />
            </Grid>
        </Border>
        <!--<TextBlock FontSize="20" Foreground="red" HorizontalAlignment="Center">Ctrl+Shift+A 向左截图</TextBlock>
        <TextBlock FontSize="20" Foreground="red" HorizontalAlignment="Center">Ctrl+Shift+D 向右截图</TextBlock>
        <TextBlock FontSize="20" Foreground="red" HorizontalAlignment="Center">Ctrl+Shift+P 停止截图</TextBlock>-->
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="24"
            Foreground="red">
            回放过程中请勿按左右按键,并且保证里程在蓝框内
        </TextBlock>
    </StackPanel>
</Window>
