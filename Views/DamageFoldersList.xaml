<Window
    x:Class="DamageMaker.Views.DamageFoldersList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DamageMaker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DamageMaker.ViewModels"
    x:Name="FoldersDataGrid"
    Title="DamageFoldersList"
    Width="1632"
    Height="795"
    d:DataContext="{d:DesignInstance Type=vm:DamageFoldersListViewModel}"
    mc:Ignorable="d">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="1" Color="#FFF5F5F5" />
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <!--  DataGrid 样式  -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="35" />
            <Setter Property="ColumnHeaderHeight" Value="50" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AlternatingRowBackground" Value="#FFF5F5F5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFB0BEC5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!--  DataGrid 表头样式  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#326cf3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF01579B" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <!--  单元格内容居中  -->
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  按钮样式  -->
        <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Setter Property="Width" Value="250" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主内容区域 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="909*" />
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="92*" />
                <ColumnDefinition Width="27*" />
                <ColumnDefinition Width="357*" />
                <ColumnDefinition Width="Auto" MinWidth="219.999" />
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <DataGrid
                x:Name="folderList"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding DamageFolders}"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                ScrollViewer.CanContentScroll="True"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                SelectedIndex="{Binding SelectedIndex}"
                SelectionChanged="folderList_SelectionChanged"
                SelectionMode="Extended">
                <DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding DoubleClickDamageFolderCommand}" CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding SerialNumber}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="序号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding FolderName}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="文件名"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Header="仪器类型"
                        IsReadOnly="True"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Binding="{Binding Instruments}" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding SelectedLineType}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="线别"
                        IsReadOnly="True" />
                    
                    <DataGridTextColumn
                        Binding="{Binding SerialNumber1}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="仪器串号"
                        Width="100"
                        IsReadOnly="True" />
                    
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding CycleNumber}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="周期号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Header="疑似伤损数量"
                        IsReadOnly="True"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Binding="{Binding SuspectedDamageCount}" />
                    <DataGridTextColumn
                        Binding="{Binding DamagePngCount}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="标记图片数量"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding PngCount}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="捕获图片数量"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding HasDocx, Converter={StaticResource Boolean2StringConverter}, ConverterParameter='否;是'}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="是否有报表数据"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding CreatTime}"
                        ElementStyle="{StaticResource CenterCellStyle}"
                        Header="创建日期"
                        IsReadOnly="True"
                        SortDirection="Descending" />
                    <DataGridTextColumn
                        Header="备注"
                        IsReadOnly="False"
                        Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ElementStyle="{StaticResource CenterCellStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 搜索框区域 - 放在备注列之后 -->
            <StackPanel
                Grid.Column="5"
                Orientation="Vertical"
                Margin="15,50,15,0"
                VerticalAlignment="Top"
                Height="49">
                <TextBlock
                    Text="搜索历史文件"
                    FontFamily="微软雅黑"
                    FontSize="12"
                    Margin="0,0,0,5"
                    Foreground="#666666" />
                <hc:SearchBar
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="0"
                    Command="{Binding SearchHistoricalFileCommand}"
                    CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchHistoricalFileText}" />
            </StackPanel>
        </Grid>

        <!-- 分页区域 -->
        <StackPanel
            Grid.Row="1"
            Margin="10,8,5,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding FirstPageCommand}"
                Content="首页" />
            <Button
                Width="80"
                Command="{Binding PreviousPageCommand}"
                Content="上一页" />
            <TextBlock
                MinWidth="260"
                Margin="15,0"
                VerticalAlignment="Center"
                FontFamily="微软雅黑"
                FontSize="14"
                Text="{Binding PageInfo}"
                TextAlignment="Center" />
            <Button
                x:Name="SelectedFoldersMenuButton"
                Width="130"
                Margin="5,0,15,0"
                VerticalAlignment="Center"
                Content="{Binding SelectedCountText}"
                Click="SelectedFoldersMenuButton_Click"
                Tag="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding PlacementTarget.Tag.SelectedFolders, RelativeSource={RelativeSource Self}}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="{Binding FolderName}" />
                                <EventSetter Event="Click" Handler="SelectedFolderMenuItem_Click" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button
                Width="80"
                Command="{Binding NextPageCommand}"
                Content="下一页" />
            <Button
                Width="80"
                Command="{Binding LastPageCommand}"
                Content="尾页" />
        </StackPanel>

        <!-- 按钮区域 -->
        <UniformGrid
            Grid.Row="2"
            Margin="10,10,5,10"
            Columns="7">
            <Button
                Command="{Binding OpenDocxCommand}"
                CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}"
                Content="打开Word报告" />
            <Button
                Command="{Binding ExportReportCommand}"
                CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}"
                Content="导出Word报告" />
            <Button Command="{Binding ExportExcelCommand}" Content="导出Excel" />
            <Button
                Command="{Binding DeleteFoldersCommand}"
                CommandParameter="{Binding ElementName=folderList, Path=SelectedItem}"
                Content="删除选中项" />
            <Button
                Command="{Binding OpenInFolderCommand}"
                CommandParameter="in文件夹"
                Content="打开In根目录" />
            <Button
                Command="{Binding OpenInFolderCommand}"
                CommandParameter="Excel文件夹"
                Content="打开Excel目录" />
        </UniformGrid>
    </Grid>
</Window>
