                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 模式切换工具栏 -->
                            <Border Grid.Row="0" Background="#F5F5F5" Padding="10,5" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="显示模式:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>

                                    <!-- 模式1：按伤损类别分组 -->
                                    <RadioButton x:Name="CategoryMode" Content="按伤损类别" 
                        IsChecked="{Binding IsCategoryMode, Mode=TwoWay}"
                        GroupName="ViewMode" Margin="0,0,0,0"/>
                                    <!-- 模式2：按图片显示所有伤损 -->
                                    <RadioButton x:Name="ImageMode" 
             GroupName="ViewMode"
             Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="按图片显示"/>
                                            <TextBlock Text="{Binding TotalImages, StringFormat=' ({0}张)'}" 
                   Foreground="#2196F3" 
                   FontWeight="SemiBold"
                   Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <Separator Width="0" Visibility="Hidden"/>
                                </StackPanel>
                            </Border>

                            <!-- 内容区域：根据模式切换显示 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="281*"/>
                                    <ColumnDefinition Width="25*"/>
                                    <ColumnDefinition Width="81*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 模式1：按伤损类别分组显示 - 使用您原有的 TreeView -->
                                <TreeView x:Name="CategoryTreeView"
                  Visibility="{Binding IsCategoryMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="5,5,5,5"
                  Effect="{StaticResource EffectShadow4}"
                  ItemsSource="{Binding DamageTree}"
                  Style="{StaticResource TreeView.Small}" 
                  Height="725" 
                  Width="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.ColumnSpan="3">

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="GotKeyboardFocus">
                                            <i:InvokeCommandAction Command="{Binding LocationImgCommand}" CommandParameter="{Binding SelectedItem.FileName, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>

                                    <!-- 资源定义 -->
                                    <TreeView.Resources>
                                        <!-- 移除默认选择高亮样式 -->
                                        <Style x:Key="RemoveSelectionStyle" TargetType="TreeViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                            <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                            <Setter Property="Padding" Value="1,0,0,0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                                            <!--<Setter Property="FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}"/>-->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition MinWidth="19" Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>

                                                            <ToggleButton 
                            x:Name="Expander" 
                            ClickMode="Press" 
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                            Style="{StaticResource ExpandCollapseToggleStyle}"/>

                                                            <Border 
                            x:Name="Bd" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Background="{TemplateBinding Background}" 
                            Grid.Column="1" 
                            Padding="{TemplateBinding Padding}" 
                            SnapsToDevicePixels="true">
                                                                <ContentPresenter 
                                x:Name="PART_Header" 
                                ContentSource="Header" 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                            </Border>

                                                            <ItemsPresenter 
                            x:Name="ItemsHost" 
                            Grid.ColumnSpan="2" 
                            Grid.Column="1" 
                            Grid.Row="1"/>
                                                        </Grid>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="false">
                                                                <Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed"/>
                                                            </Trigger>
                                                            <Trigger Property="HasItems" Value="false">
                                                                <Setter Property="Visibility" TargetName="Expander" Value="Hidden"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="true">
                                                                <Setter Property="Background" TargetName="Bd" Value="LightBlue"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="false">
                                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- 图片项上下文菜单 -->
                                        <ContextMenu x:Key="ImageContextMenu" Tag="ImageMenu" Opened="ImageContextMenu_Opened">
                                            <MenuItem Header="保存图片">
                                                <MenuItem Header="有标记图片" Tag="SaveMarked" Click="MenuItem_Click"/>
                                                <MenuItem Header="无标记图片" Tag="SaveUnmarked" Click="MenuItem_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="打开文件夹" Tag="OpenImgFolder" Click="MenuItem_Click"/>
                                            <Separator />
                                            <MenuItem Header="批量操作">
                                                <MenuItem Header="有标记图片" Tag="BatchImgSaveMarked" Click="MenuItem_Click"/>
                                                <MenuItem Header="无标记图片" Tag="BatchImgSaveUnmarked" Click="MenuItem_Click"/>
                                                <Separator />
                                            </MenuItem>
                                        </ContextMenu>

                                        <!-- 分类项上下文菜单 -->
                                        <ContextMenu x:Key="CategoryContextMenu" Tag="CategoryMenu" Opened="CategoryContextMenu_Opened">
                                            <MenuItem Header="导出当前所有图片">
                                                <MenuItem Header="有标记图片" Tag="ExportAllMarked" Click="MenuItem_Click"/>
                                                <MenuItem Header="无标记图片" Tag="ExportAllUnmarked" Click="MenuItem_Click"/>
                                            </MenuItem>
                                            <MenuItem Header="打开文件夹" Tag="OpenAllFolder" Click="MenuItem_Click"/>
                                            <Separator />
                                            <MenuItem Header="批量操作">
                                                <MenuItem Header="有标记图片" Tag="BatchSaveMarked" Click="MenuItem_Click"/>
                                                <MenuItem Header="无标记图片" Tag="BatchSaveUnmarked" Click="MenuItem_Click"/>
                                                <Separator />
                                            </MenuItem>
                                            <Separator />
                                        </ContextMenu>
                                        <!-- 数据模板 -->

                                        <!-- 分类摘要节点 -->
                                        <HierarchicalDataTemplate DataType="{x:Type md:DamageCategorySummaryTree}" ItemsSource="{Binding Children}">
                                            <TextBlock FontSize="17" Text="{Binding Name}" ContextMenu="{StaticResource CategoryContextMenu}"/>
                                        </HierarchicalDataTemplate>

                                        <!-- 分类节点 -->
                                        <HierarchicalDataTemplate DataType="{x:Type md:DamageCategoryTree}" ItemsSource="{Binding Children}">
                                            <Border ContextMenu="{StaticResource CategoryContextMenu}">
                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource BorderTipDanger}" TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ColorBrush}" Value="{x:Static Brushes.Green}">
                                                                <Setter Property="Background" Value="{StaticResource LightSuccessBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ColorBrush}" Value="{x:Static Brushes.YellowGreen}">
                                                                <Setter Property="Background" Value="{StaticResource LightWarningBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Width="210" Orientation="Horizontal">
                                                    <!-- ✅ 使用独立的 IsChecked 属性 -->
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,5,0"
                          Command="{Binding DataContext.ToggleCategorySelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          CommandParameter="{Binding}"/>
                                                    <TextBlock FontSize="{StaticResource SubHeadFontSize}"
                           MouseDown="TextBlock_MouseDown"
                           Text="{Binding Name}" />
                                                    <TextBlock FontSize="16" 
                           Text="{Binding Count, StringFormat='  次数:{0}'}" 
                           Visibility="{Binding Count, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </HierarchicalDataTemplate>

                                        <!-- 图片详情节点 -->
                                        <DataTemplate DataType="{x:Type md:Details}">
                                            <Border 
                Width="300"
                Margin="5"
                BorderThickness="2"
                CornerRadius="5"
                Effect="{StaticResource EffectShadow4}"
                MouseDown="Border_MouseDown" 
                ContextMenu="{StaticResource ImageContextMenu}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BorderTipPrimary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="Red" />
                                                                <Setter Property="BorderThickness" Value="3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static md:DamageStatus.UNKNOWN}">
                                                                <Setter Property="Background" Value="{Binding StatusColor, Mode=OneWay}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static md:DamageStatus.KNOWN}">
                                                                <Setter Property="Background" Value="{Binding StatusColor, Mode=OneWay}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static md:DamageStatus.HASDAMAGE}">
                                                                <Setter Property="Background" Value="{Binding StatusColor, Mode=OneWay}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static md:DamageStatus.NODAMAGE}">
                                                                <Setter Property="Background" Value="{Binding StatusColor, Mode=OneWay}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <!-- ✅ 使用独立的 IsChecked 属性 -->
                                                    <CheckBox DockPanel.Dock="Left" 
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" 
                          Margin="5,0,5,0" 
                          Focusable="False"/>

                                                    <!-- 索引指示器 -->
                                                    <Border DockPanel.Dock="Left"
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        Background="#FF4285F4"
                        CornerRadius="14">
                                                        <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="Bold"
                               Text="{Binding DisplayIndex}" />
                                                    </Border>

                                                    <!-- 主要内容 -->
                                                    <StackPanel>
                                                        <TextBlock FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FF212121"
                               Text="{Binding FileName, StringFormat='里程号: {0}'}"
                               TextTrimming="CharacterEllipsis" />

                                                        <WrapPanel Margin="0,5,0,0">
                                                            <TextBlock Margin="0,0,10,0"
                                   Foreground="#FF757575"
                                   Text="{Binding Count, StringFormat='次数: {0}'}" />

                                                            <TextBlock Foreground="#FF757575"
                                   Text="{Binding WeightText, StringFormat='权重: {0}'}"
                                   Visibility="{Binding weight, Converter={StaticResource Object2VisibilityConverter}}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </TreeView.Resources>

                                    <!-- ItemContainerStyle：不再绑定 IsSelected 到 UI 选中行为（或保留仅用于导航） -->
                                    <TreeView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource RemoveSelectionStyle}" TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <!-- ❌ 移除了 IsSelected 双向绑定，避免干扰 CheckBox -->
                                            <!-- 如果你需要"当前项"高亮，可改为 OneWay 绑定或用其他方式实现 -->
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                <!-- 模式2：按图片显示所有伤损类别 -->
                                <TreeView x:Name="ImageTreeView"
          Visibility="{Binding IsImageMode, Converter={StaticResource BooleanToVisibilityConverter}}"
          Margin="5,5,5,5"
                                          Height="725"
          ItemsSource="{Binding ImageTree}"
          Style="{StaticResource TreeView.Small}" 
          ScrollViewer.VerticalScrollBarVisibility="Visible"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          VirtualizingStackPanel.IsVirtualizing="True"
          VirtualizingStackPanel.VirtualizationMode="Recycling"
          Focusable="True" 
          VirtualizingStackPanel.ScrollUnit="Item" Grid.ColumnSpan="3">

                                    <!-- 添加交互触发器 -->
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="GotKeyboardFocus">
                                            <i:InvokeCommandAction Command="{Binding LocationImgCommand}" 
                                  CommandParameter="{Binding SelectedItem.FileName, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
                                        </i:EventTrigger>

                                        <!-- 或者添加鼠标点击事件 -->
                                        <i:EventTrigger EventName="SelectedItemChanged">
                                            <i:InvokeCommandAction Command="{Binding LocationImgCommand}" 
                                  CommandParameter="{Binding SelectedItem.FileName, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>

                                    <TreeView.Resources>
                                        <!-- 简化图片分组节点模板 -->
                                        <HierarchicalDataTemplate DataType="{x:Type md:ImageGroupTree}" ItemsSource="{Binding DamageCategories}">
                                            <StackPanel Orientation="Horizontal" Margin="2" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding DamageCount, StringFormat=' ({0})'}" 
                          Foreground="#666" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>

                                        <!-- 简化伤损类别模板 -->
                                        <HierarchicalDataTemplate DataType="{x:Type md:ImageDamageCategory}" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="8,1" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,6,0"/>
                                                <Rectangle Width="10" Height="10" Fill="{Binding ColorBrush}" RadiusX="1" RadiusY="1"/>
                                                <TextBlock Text="{Binding Name}" Margin="6,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Count, StringFormat='({0})'}" Foreground="#666" FontSize="11"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>

                                        <!-- 简化伤损详情模板 -->
                                        <DataTemplate DataType="{x:Type md:ImageDamageDetail}">
                                            <StackPanel Orientation="Horizontal" Margin="12,1" Background="Transparent">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                          VerticalAlignment="Center" 
                          Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="12"/>
                                                <TextBlock Text="{Binding weight, StringFormat=' ({0:P0})'}" 
                          Foreground="#666" Margin="6,0,0,0" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Style="{StaticResource RightNavTabItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <TabItem.Header>
                        <TextBlock
                            Style="{StaticResource RightNavHeaderTextStyle}"
                            Text="单个总览" />
                    </TabItem.Header>
                    <StackPanel>
                        <DataGrid
                            Height="690"
                            Margin="3"
                            AutoGenerateColumns="False"
                            Effect="{StaticResource EffectShadow4}"
                            ItemsSource="{Binding DetailsList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Id}" Header="编号" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.Header>伤损分类</DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding MarkerColor}" Text="{Binding DamageCategory}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--<DataGridTextColumn Binding="{Binding DamageCategory}"  Header="伤损类别" />-->
                                <DataGridTextColumn Binding="{Binding Similarity}" Header="相似度" />
                                <DataGridTemplateColumn Header="操作">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ToggleButton Content="显示"
                                                    Margin="2,0"
                                                    Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ToggleButtonSuccess}" />
                                                <ToggleButton Content="返回"
                                                    Margin="2,0"
                                                    Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ToggleButtonDanger}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <!-- 第一个部分调整高度和布局 -->
            <Grid
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <StackPanel 
                    Grid.Column="0"
                    Margin="10,0,0,0" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <Border 
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Margin="0,0,5,0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{Binding PortStatusColor}"
                        ToolTip="连接状态"
                        VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect 
                                BlurRadius="8" 
                                ShadowDepth="0" 
                                Color="#80000000"
                                Opacity="0.6"/>
                        </Border.Effect>
                    </Border>

                    <TextBlock 
                        Text="{Binding PortStatusText}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <hc:ProgressButton
                        Width="70"
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="0"
                        Command="{Binding StartPythonScriptCommand}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        IsChecked="{Binding IsStartPython}"
                        Style="{StaticResource ToggleButtonLoadingPrimary}"
                        Visibility="{Binding StartPythonVisible}"
                        ToolTip="启动探伤分析服务">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path 
                                Data="M 0,0 L 12,6 L 0,12 Z" 
                                Fill="{DynamicResource SuccessBrush}"
                                Width="12"
                                Height="12"
                                Margin="0,0,5,0"
                                Stretch="Uniform"/>
                            <TextBlock 
                                Text="启动"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </hc:ProgressButton>

                    <Button
                        Width="70"
                        Height="28"
                        Padding="0"
                        
                        Command="{Binding StopPythonScriptCommand}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="#FBC115"
                        BorderBrush="#FBC115"
                        Visibility="{Binding StopPythonVisible}"
                        ToolTip="停止探伤分析服务">
                        <StackPanel Orientation="Horizontal">
                            <Path 
                                Data="M 0,0 H 12 V 12 H 0 Z" 
                                Fill="#FFF44336"
                                Width="12"
                                Height="12"
                                Margin="0,0,3,0"
                                Stretch="Uniform"/>
                            <TextBlock Text="停止"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <UniformGrid
                    Grid.Column="1"
                    Columns="3"
                    VerticalAlignment="Center"
                    Height="42">
                    <!-- 设置固定高度 -->
                    <!-- 原有内容保持不变 -->
                    <StackPanel
        Grid.ColumnSpan="2"
        Orientation="Horizontal"
        Margin="0,5,0,0"
        Visibility="{Binding CycleCompareProgressVisibility}">
                        <TextBlock 
            VerticalAlignment="Center"
            Width="80"
            Text="周期对比:"
            Style="{StaticResource TextBlockBaseStyle}"/>
                        <ProgressBar
                           
            Width="240"
            HorizontalAlignment="Left"
            Margin="5,0,0,0"
            Maximum="{Binding TotalCycleCompareProgress}"
            Style="{StaticResource ProgressBarInfo}"
            Value="{Binding CurrentCycleCompareProgress}" />
                        <TextBlock 
            VerticalAlignment="Center"
            Margin="5,0,0,0"
            Text="{Binding CycleCompareProgressText}"
            Style="{StaticResource TextBlockBaseStyle}"/>
                    </StackPanel>
                    <StackPanel
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Visibility="{Binding ImgProgressVisibility}">
                        <TextBlock VerticalAlignment="Center">图片绘制进度:</TextBlock>
                        <ProgressBar
                            Width="240"
                            Height="30"
                            HorizontalAlignment="center"
                            Maximum="{Binding TotalImgProgress}"
                            Style="{StaticResource ProgressBarSuccess}"
                            Value="{Binding CurrentImgProgress}" />
                    </StackPanel>
                    <StackPanel
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Visibility="{Binding ProgressVisibility}">
                        <TextBlock VerticalAlignment="Center">判伤进度:</TextBlock>
                        <ProgressBar
                            Width="240"
                            Height="30"
                            HorizontalAlignment="center"
                            Maximum="{Binding TotalProgress}"
                            Style="{StaticResource ProgressBarSuccess}"
                            Value="{Binding CurrentProgress}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding StopProgressCommand}"
                            Content="停止"
                            Style="{StaticResource ButtonWarning}" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock
                    Grid.Column="1"
                    FontSize="30"
                    Foreground="#3565B5"
                    ToolTip="标记图片数/当前图片数" RenderTransformOrigin="-0.625,0.526" Width="300" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="990,0,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="SingleImgCount" />
                            <Binding Path="AllImgCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,60,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Foreground="#6075A5"
                    Text="{Binding Version}" />
            </Grid>

            <!-- 第二个部分调整高度和宽度 -->
            <Grid
                Grid.Row="3"
                Grid.RowSpan="3"
                Grid.Column="0"
                Margin="90,76,30,0">
                <!-- 与上方缩略图列表同步上移，保持两者原有相对距离 -->
                <Grid.RenderTransform>
                    <TranslateTransform Y="-44"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- 图片区域自适应 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 控制按钮区域自动高度 -->
                </Grid.RowDefinitions>

                <!-- 外层用一个 Grid 包裹 Viewbox 和 按钮 -->
                <Grid Grid.Row="0" Grid.RowSpan="1">
                    <Viewbox 
        x:Name="MainImageViewbox"
        Stretch="Uniform"
        MaxWidth="1360"
        MaxHeight="560"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="0">
                        <Border BorderBrush="{Binding ImgBorderBrush}" BorderThickness="4" Background="#FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.18"/>
                            </Border.Effect>
                            <local:DamageDisplayBox 
                x:Name="damageViewer"
                Width="1920"
                Height="800"
                SourceImage="{Binding ImgSource}"
                MouseWheel="DamageViewer_MouseWheel"
                MouseMove="DamageViewer_MouseMove"
                MouseLeftButtonDown="DamageViewer_MouseLeftButtonDown"
                MouseLeftButtonUp="DamageViewer_MouseLeftButtonUp"
                Loaded="damageViewer_Loaded_1">
                                <local:DamageDisplayBox.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </local:DamageDisplayBox.RenderTransform>
                            </local:DamageDisplayBox>
                        </Border>
                    </Viewbox>

                    <!-- 判伤进度结束后、正式绘图前的醒目处理中提示 -->
                    <Border
                        Width="620"
                        MinHeight="190"
                        Padding="34,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F2F6FF"
                        BorderBrush="#3A79F4"
                        BorderThickness="3"
                        CornerRadius="16"
                        Panel.ZIndex="998"
                        Visibility="{Binding ResultProcessingVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#3A79F4"
                                Text="正在处理结果"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22"
                                FontSize="18"
                                Foreground="#455A75"
                                Text="分析已完成，正在准备绘制图片，请稍候..."/>
                            <ProgressBar
                                Width="500"
                                Height="18"
                                HorizontalAlignment="Center"
                                IsIndeterminate="True"
                                Foreground="#3A79F4"
                                Style="{StaticResource ProgressBarInfo}"/>
                        </StackPanel>
                    </Border>

                    <!-- 悬浮保存按钮（不挡图片）-->
                    <Button Click="ExportOriginalImage_Click"
            Width="40"
            Height="40"
            Background="#AAFFFFFF"
            ToolTip="导出原图"
            BorderThickness="0"
            FontSize="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,-10,-10,0"
            Panel.ZIndex="999">
                        <TextBlock Text="💾"/>
                    </Button>
                </Grid>


                <!-- 底部控制区：伤损等级独占上排，操作按钮独占下排，避免互相遮挡 -->
                <Grid
                    Grid.Row="1"
                    MaxWidth="1360"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0" Width="1314">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 伤损等级：位于操作按钮上方，并与图片框体保持间距 -->
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,170,4"
                        Orientation="Horizontal"
                        Panel.ZIndex="5">
                        <Label
                            Width="86"
                            Padding="0"
                            Margin="0,0,4,0"
                            VerticalContentAlignment="Center"
                            Content="伤损等级:"
                            Foreground="{StaticResource ShanHePurpleBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            FocusVisualStyle="{x:Null}"/>
                        <ComboBox
                            Width="84"
                            Height="28"
                            VerticalAlignment="Center"
                            SelectedValue="{Binding DamageLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource NullToEmptyStringConverter}}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content=" " Tag=" "/>
                            <ComboBoxItem Content="I" Tag="1"/>
                            <ComboBoxItem Content="II" Tag="2"/>
                            <ComboBoxItem Content="III" Tag="3"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 操作按钮排：整体靠右，右端比图片框体右端略向左 -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,0"
                        Orientation="Horizontal"
                        Panel.ZIndex="4">
                        <TextBlock
                            Name="RuleInfo"
                            Width="70"
                            Height="30" />
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Margin="10,3"
                                HorizontalAlignment="Center"
                                Command="{Binding SmartCompareCommand}"
                                ToolTip="查看周期对比图片"
                                Content="查看周期对比图片"
                                Width="150"
                                Height="36"
                                Background="{StaticResource ShanHeOrangeBrush}"
                                BorderBrush="{StaticResource ShanHeOrangeBrush}"
                                Foreground="White"
                                BorderThickness="1"
                                FontWeight="SemiBold"/>
                            <Button
                                Margin="10,3"
                                HorizontalAlignment="Center"
                                Background="#18A6C9"
                                BorderBrush="#18A6C9"
                                Command="{Binding ModifyImgCommand}"
                                Content="修改当前标记[Z]"/>
                            <ToggleButton
                                Width="130"
                                Height="40"
                                Margin="10,3"
                                Background="#18A6C9"
                                BorderBrush="#18A6C9"
                                Checked="ToggleButton_Checked"
                                Command="{Binding ShowAllBoxSelectedCommand}"
                                IsChecked="{Binding IsShowAllBoxSelected}"
                                Content="显示标记[S]"/>
                            <Button
                                Margin="10,3"
                                Background="{StaticResource ShanHeBlueBrush}"
                                BorderBrush="{StaticResource ShanHeBlueBrush}"
                                Command="{Binding StartSnipasteCommand}"
                                Content="探头颜色展示"/>
                            <ToggleButton
                                Margin="10,3"
                                Command="{Binding NoDamageCheckCommand}"
                                CommandParameter="鼠标点击"
                                IsEnabled="{Binding IsNoDamageBtnEnabled}"
                                Focusable="False"
                                Style="{StaticResource ToggleButtonSuccess}"
                                Content="无伤[O]"/>
                            <ToggleButton
                                Margin="10,3"
                                Command="{Binding DamageCheckCommand}"
                                CommandParameter="鼠标点击"
                                IsEnabled="{Binding IsDamageBtnEnabled}"
                                Focusable="False"
                                Style="{StaticResource ToggleButtonDanger}"
                                Content="疑似[P]"/>
                            <TextBlock
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="DemiBold"
                                Foreground="{StaticResource ShanHePurpleBrush}"
                                Text="备注:"
                                Height="18" />
                            <TextBox
                                Width="115"
                                Height="35"
                                Margin="3"
                                IsReadOnly="{Binding IsReadRemarkOnly}"
                                Text="{Binding DamageRemark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="WrapWithOverflow" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</hc:Window>
