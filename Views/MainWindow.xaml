<hc:Window
    x:Class="DamageMarker.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvs="clr-namespace:DamageMaker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DamageMaker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:DamageMaker.Models"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:vm="clr-namespace:DamageMarker.ViewModels"
    Title="探伤分析系统"
    Width="1920"
    Height="1000"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    Icon="../Resources/Logo.png"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.Resources>
        <cvs:AddOneConverter x:Key="AddOneConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Command="{Binding ModifyImgCommand}" />
        <KeyBinding Key="O" Command="{Binding NoDamageCheckCommand}" />
        <KeyBinding Key="P" Command="{Binding DamageCheckCommand}" />
        <KeyBinding
            Key="S"
            Command="{Binding ShowAllBoxSelectedCommand}"
            CommandParameter="键盘触发" />
        <KeyBinding
            Key="W" Modifiers="Ctrl" Command="{Binding WinClosingCommand}"/>
    </Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WinClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border>
        <Grid Background="{DynamicResource RegionBrush}">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="Scal" />
            </Grid.LayoutTransform>
            <Grid.Resources>
                <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
                    <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    <Setter Property="Width" Value="130" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style BasedOn="{StaticResource TextBlockDefaultPrimary}" TargetType="TextBlock" />
                <Style BasedOn="{StaticResource ToggleButtonPrimary}" TargetType="ToggleButton">
                    <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    <Setter Property="Width" Value="130" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="49*" />
                <ColumnDefinition Width="191*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="3.5*" />
                <RowDefinition Height="9*" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.RowSpan="3">
                <Image Height="80" Source="../Resources/Logo.png" />
                <TextBlock
                    Margin="5"
                    FontFamily="楷体"
                    FontSize="18"
                    FontWeight="Bold">
                    合肥平行线机器人
                </TextBlock>
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="900"
                Height="68"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontFamily="楷体"
                    FontSize="60"
                    FontWeight="Bold"
                    Text="{Binding AppTitle}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                    Grid.Column="1"
                    Width="390"
                    Height="60"
                    Margin="1174,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox
                        FontSize="12"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        IsChecked="{Binding IsDetectionAsynChecked}"
                        IsEnabled="{Binding IsDetectionAsynEnable}">
                        探伤软件同步搜索
                    </CheckBox>
                    <TextBlock 
                        Margin="30,0" 
                        Text="6M"
                        FontSize="12"
                        FontWeight="Normal"
                        VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is6MRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock 
                        Text="8C"
                        FontSize="12"
                        FontWeight="Normal"
                        VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is8CRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <hc:SearchBar
                    Width="276"
                    Height="32"
                    Margin="15,5,0,0"
                    hc:InfoElement.Placeholder="格式为:300km200(中间以km或KM为分割)"
                    hc:InfoElement.Title="里程定位"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    Background="{StaticResource LightBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Command="{Binding SearchMileageCommand}"
                    CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
                    FontSize="12"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchMileageText}">
                    <hc:SearchBar.Effect>
                        <DropShadowEffect BlurRadius="2" Opacity="0.1" ShadowDepth="1"/>
                    </hc:SearchBar.Effect>
                </hc:SearchBar>
            </StackPanel>
            <hc:Drawer
                Name="DrawerLeft"
                Content="{Binding Setup}"
                Dock="Left"
                Effect="{StaticResource EffectShadow4}"
                ShowMode="Push" />
            <StackPanel
                Grid.Row="0"
                Width="0"
                HorizontalAlignment="Center" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Width="450"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <TextBlock
                    Width="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource SubHeadFontSize}"
                    FontStyle="Italic"
                    Text="{Binding ImgFolderName}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Width="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="Visible" />
            <UniformGrid
                Grid.Row="1"
                Grid.Column="1"
                Columns="3"
                Rows="0">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
            </UniformGrid>
            <GroupBox
                Grid.Row="3"
                Grid.RowSpan="1"
                Grid.Column="1"
                Header="{x:Null}"
                Background="Transparent"
                Margin="0,0,10,32"
                hc:TitleElement.TitlePlacement="Top"
                Effect="{StaticResource EffectShadow4}"
                Style="{StaticResource InputElementBaseStyle}">

                <GroupBox.Resources>
                    <!-- 自定义ListBox样式 -->
                    <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    </Style>
                    <!-- 自定义ListBoxItem样式 -->
                    <Style x:Key="ModernListBoxItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border
                                                x:Name="InnerBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Margin="1"/>
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                            Margin="10"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                                            <Setter TargetName="Border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#4CAF50" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2196F3"/>
                                            <Setter TargetName="InnerBorder" Property="Background" Value="#E3F2FD"/>
                                            <Setter TargetName="Border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#2196F3" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupBox.Resources>

                <hc:ScrollViewer hc:ScrollViewerAttach.Orientation="Horizontal">
                    <ListBox
                        x:Name="ThumbnailList"
                        ItemsSource="{Binding ThumbnailImgInfos}"
                        SelectedIndex="{Binding SelectedIndex}"
                        SelectedItem="{Binding SelectedThumbnailImg}"
                        SelectionChanged="ThumbnailList_SelectionChanged"
                        Style="{StaticResource ModernListBoxStyle}"
                        ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <ListBox.Resources>
                            <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">80</system:Double>
                        </ListBox.Resources>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding ImgSelectionChangedCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 美化文本显示 -->
                                    <TextBlock
                                        Width="180"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#333333"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:ScrollViewer>
            </GroupBox>
            <TextBlock
                Width="80"  
                FontSize="16"  
                Text="图片展示区"
                FontWeight="Bold"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,46,0,0"
                Grid.Column="1" 
                Grid.Row="1"
                Height="32"
                Foreground="Blue"  
                RenderTransformOrigin="0.5,0.5" Grid.RowSpan="2">

                <TextBlock.Effect>
                    <DropShadowEffect 
                        Color="#33000000" 
                        BlurRadius="4" 
                        ShadowDepth="1" 
                        Direction="315" 
                        Opacity="0.3"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="2"/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation 
                        Storyboard.TargetProperty="Foreground.Color"
                        To="#FF7043"  
                                    Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation 
                                    Storyboard.TargetProperty="Foreground.Color"
                                    To="#4A6BFF"  
                                    Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
            <TabControl
                Grid.Row="2"
                Grid.RowSpan="4"
                Margin="8,8,10,8"
                Background="Transparent">
                <TabControl.Resources>
                    <Style BasedOn="{StaticResource TabControlCapsuleSolid}" TargetType="TabControl">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    </Style>
                </TabControl.Resources>
                <TabItem >
                    <TabItem.Header>
                        <TextBlock
                            FontSize="{StaticResource SubHeadFontSize}"
                            Foreground="{StaticResource DarkInfoBrush}"
                            Text="功能区" />
                    </TabItem.Header>
                    <StackPanel 
                        Background="Transparent" 
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Top">
                        <GroupBox
                            Height="353"
                            Width="332"
                            Style="{StaticResource GroupBoxTab.Small}"
                            Background="{DynamicResource RegionBrush}"
                            Margin="0,10">
                            <UniformGrid Columns="0" Rows="3">
                                <Menu
                                    Width="130"
                                    Height="40"
                                    BorderThickness="1"
                                    Effect="{StaticResource EffectShadow4}"
                                    Style="{StaticResource InputElementBaseStyle}"
                                    Background="#4A6BFF">
                                    <MenuItem ItemsSource="{Binding MenuItems}">
                                        <MenuItem.Header>
                                            <Border 
                                                Width="111" 
                                                Height="38"
                                                Background="#4A6BFF"
                                                CornerRadius="8"
                                                Padding="0"
                                                SnapsToDevicePixels="True">
                                                <TextBlock
                                                    Text="选择软件"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="16"
                                                    TextAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>
                                            </Border>
                                        </MenuItem.Header>
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem
                                                    Background="{StaticResource PrimaryBrush}"
                                                    Command="{Binding Command}"
                                                    CommandParameter="{Binding CommandParameter}"
                                                    FontSize="16"
                                                    Foreground="White"
                                                    Header="{Binding Header}" />
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                </Menu>
                                <Button hc:IconElement.Geometry="{StaticResource FullScreenReturnGeometry}" Command="{Binding ScreenShotFuncCommand}">
                                    数据捕获
                                </Button>
                                <Button
                                    HorizontalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource AlignBottomGeometry}"
                                    Command="{Binding GetJsonResultCommand}"
                                    ToolTip="手动获取探伤数据">
                                    开始分析
                                </Button>
                            </UniformGrid>
                        </GroupBox>
                        <GroupBox
                            Grid.Row="4"
                            Height="337"
                            Margin="0,10"
                            Style="{StaticResource GroupBoxTab.Small}"
                            Background="{DynamicResource RegionBrush}" Width="332">
                            <UniformGrid Rows="4">
                                <ToggleButton
                                    Width="NaN"
                                    Height="40"
                                    Margin="96,0,96,0"
                                    hc:IconElement.Geometry="{StaticResource WindowsGeometry}"
                                    Effect="{StaticResource EffectShadow4}"
                                    FontSize="14"
                                    IsChecked="{Binding IsOpen, ElementName=DrawerLeft}" HorizontalAlignment="Stretch">
                                    系统设置
                                </ToggleButton>
                                <Button
                                    hc:IconElement.Geometry="{StaticResource ClockGeometry}"
                                    Command="{Binding SelectedPathCommand}"
                                    ToolTip="打开以前的判伤集">
                                    历史回放
                                </Button>
                                <ToggleButton
                                    Width="130"
                                    Height="40"
                                    Margin="4"
                                    hc:IconSwitchElement.Geometry="{StaticResource EyeOpenGeometry}"
                                    Click="bthClick"
                                    Command="{Binding FilterImgCommand}"
                                    Effect="{StaticResource EffectShadow4}"
                                    FontSize="14"
                                    IsChecked="{Binding IsFilterThumbnail}"
                                    IsEnabled="{Binding IsEnableThumbnail}"
                                    Style="{StaticResource ToggleButtonPrimary}"
                                    ToolTip="隐藏没有探伤数据的图片">
                                    数据筛选
                                </ToggleButton>
                                <ToggleButton
                                    Width="130"
                                    Height="40"
                                    Margin="4"
                                    Command="{Binding ExportReportCommand}"
                                    IsChecked="{Binding IsImporting}"
                                    Style="{StaticResource ToggleButtonLoadingPrimary}">
                                    导出报告
                                </ToggleButton>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Height="30">
                    <TabItem.Header>
                        <TextBlock
                            FontSize="{StaticResource SubHeadFontSize}"
                            Foreground="{StaticResource DarkInfoBrush}"
                            Text="项目总览" />
                    </TabItem.Header>
                    <TreeView
                            Name="TV"
                            Margin="5,5,-11,5"
                            Effect="{StaticResource EffectShadow4}"
                            ItemsSource="{Binding DamageTree}"
                            Style="{StaticResource TreeView.Small}" Height="725" Width="367">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotKeyboardFocus">
                                <i:InvokeCommandAction Command="{Binding LocationImgCommand}" CommandParameter="{Binding SelectedItem.FileName, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource TreeViewItemBaseStyle}" TargetType="TreeViewItem">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type md:DamageCategorySummaryTree}" ItemsSource="{Binding Children}">
                                <TextBlock FontSize="17" Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate
                                    AlternationCount="1000"
                                    DataType="{x:Type md:DamageCategoryTree}"
                                    ItemsSource="{Binding Children}">
                                <Border>
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource BorderTipDanger}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ColorBrush}" Value="{x:Static Brushes.Green}">
                                                    <Setter Property="Background" Value="{StaticResource LightSuccessBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ColorBrush}" Value="{x:Static Brushes.YellowGreen}">
                                                    <Setter Property="Background" Value="{StaticResource LightWarningBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Width="210" Orientation="Horizontal">
                                        <TextBlock
                                                FontSize="{StaticResource SubHeadFontSize}"
                                                MouseDown="TextBlock_MouseDown"
                                                Text="{Binding Name}" />
                                        <TextBlock FontSize="16" Text="{Binding Count, StringFormat='  次数:{0}'}" />
                                    </StackPanel>
                                </Border>

                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type md:Details}">

                                <Border
                                    Margin="5"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    Effect="{StaticResource EffectShadow4}"
                                    MouseDown="Border_MouseDown"
                                    Background="{Binding Background}">

                                    <!-- 保留样式的基础样式，但不覆盖 Background -->
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BorderTipPrimary}">
                                            <!-- ❌ 不要再在这里设置 Background 否则会覆盖绑定 -->
                                            <!-- <Setter Property="Background" Value="White" /> -->
                                        </Style>
                                    </Border.Style>

                                    <WrapPanel Width="200" Orientation="Horizontal">
                                        <Label HorizontalAlignment="Right"
                         Content="{Binding (ItemsControl.AlternationIndex), 
                         RelativeSource={RelativeSource AncestorType=TreeViewItem}, 
                         StringFormat='{}{0}', 
                         Converter={StaticResource AddOneConverter}}" />
                                        <TextBlock
                         x:Name="summaryFileName"
                         Width="120"
                         Margin="5,0"
                         Foreground="Black"
                         Text="{Binding FileName, StringFormat='里程号:{0}'}"
                         ToolTip="{Binding FileName}" />
                                        <hc:ElementGroup>
                                            <TextBlock
                             Margin="10,0"
                             Foreground="Black"
                             Text="{Binding Count, StringFormat='次数:{0}'}" />
                                            <TextBlock
                             Margin="10,0"
                             Foreground="Black"
                             Text="{Binding weight, StringFormat='权重:{0}'}"
                             Visibility="{Binding weight, Converter={StaticResource Object2VisibilityConverter}}" />
                                        </hc:ElementGroup>
                                    </WrapPanel>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </TabItem>
                <TabItem Height="30" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <TabItem.Header>
                        <TextBlock
                            FontSize="{StaticResource SubHeadFontSize}"
                            Foreground="{StaticResource DarkInfoBrush}"
                            Text="单个总览" />
                    </TabItem.Header>
                    <StackPanel>
                        <ToggleButton
                            Width="100"
                            Margin="5"
                            Content="隐藏正常标记"
                            Effect="{StaticResource EffectShadow4}"
                            IsChecked="{Binding IsHideNormalMarker}"
                            Style="{StaticResource ToggleButtonSwitch}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding HideNormalMarkerCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ToggleButton>
                        <DataGrid
                            Height="690"
                            Margin="3"
                            AutoGenerateColumns="False"
                            Effect="{StaticResource EffectShadow4}"
                            ItemsSource="{Binding DetailsList}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Id}" Header="编号" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.Header>伤损分类</DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding MarkerColor}" Text="{Binding DamageCategory}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--<DataGridTextColumn Binding="{Binding DamageCategory}"  Header="伤损类别" />-->
                                <DataGridTextColumn Binding="{Binding Similarity}" Header="相似度" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton
                                                    Margin="2"
                                                    Focusable="False"
                                                    Style="{StaticResource ToggleButtonSuccess}"
                                                    >
                                                    
                                                    显示
                                                </ToggleButton>
                                                <ToggleButton
                                                    Margin="2"
                                                    Focusable="False"
                                                    Style="{StaticResource ToggleButtonDanger}">
                                                    隐藏
                                                </ToggleButton>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <!-- 第一个部分调整高度和布局 -->
            <Grid
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0">
                <UniformGrid
                    Columns="4"
                    VerticalAlignment="Center"
                    Height="60">
                    <!-- 设置固定高度 -->
                    <!-- 原有内容保持不变 -->
                    <StackPanel 
                        Margin="10,0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Border 
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            Margin="0,0,5,0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{Binding PortStatusColor}"
                            ToolTip="连接状态"
                            VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect 
                                    BlurRadius="8" 
                                    ShadowDepth="0" 
                                    Color="#80000000"
                                    Opacity="0.6"/>
                            </Border.Effect>
                        </Border>

                        <!-- 状态文本 -->
                        <TextBlock 
                            Text="{Binding PortStatusText}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <!-- 启动按钮（手动播放图标 ▶） -->
                        <hc:ProgressButton
                            Width="70"
                            Height="28"
                            Margin="0,0,5,0"
                            Padding="0"
                            Command="{Binding StartPythonScriptCommand}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            IsChecked="{Binding IsStartPython}"
                            Style="{StaticResource ToggleButtonLoadingPrimary}"
                            Visibility="{Binding StartPythonVisible}"
                            ToolTip="启动探伤分析服务">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path 
                                    Data="M 0,0 L 12,6 L 0,12 Z" 
                                    Fill="{DynamicResource SuccessBrush}"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,5,0"
                                    Stretch="Uniform"/>
                                    <TextBlock 
                                    Text="启动"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </hc:ProgressButton>

                        <Button
                            Width="70"
                            Height="28"
                            Padding="0"
                            Command="{Binding StopPythonScriptCommand}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Style="{StaticResource ButtonWarning}"
                            Visibility="{Binding StopPythonVisible}"
                            ToolTip="停止探伤分析服务">
                            <StackPanel Orientation="Horizontal">
                                <Path 
                                    Data="M 0,0 H 12 V 12 H 0 Z" 
                                    Fill="	#FFF44336"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,3,0"
                                    Stretch="Uniform"/>
                                    <TextBlock Text="停止"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Visibility="{Binding ProgressVisibility}">
                        <TextBlock VerticalAlignment="Center">判伤进度:</TextBlock>
                        <ProgressBar
                            Width="240"
                            HorizontalAlignment="center"
                            Maximum="{Binding TotalProgress}"
                            Style="{StaticResource ProgressBarSuccess}"
                            Value="{Binding CurrentProgress}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding StopProgressCommand}"
                            Content="停止"
                            Style="{StaticResource ButtonWarning}" />
                    </StackPanel>
                    <TextBlock FontSize="{StaticResource DefaultControlHeight}" ToolTip="当前图片数/标记图片数">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="AllImgCount" />
                                <Binding Path="SingleImgCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Version}" />
                </UniformGrid>
            </Grid>

            <!-- 第二个部分调整高度和宽度 -->
            <Grid
                Grid.Row="3"
                Grid.RowSpan="3"
                Grid.Column="1"
                Margin="0,79,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- 图片区域自适应 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 控制按钮区域自动高度 -->
                </Grid.RowDefinitions>

                <Viewbox 
                    Grid.Row="0"
                    Stretch="Uniform"
                    MaxWidth="1552"
                    MaxHeight="564">
                    <Border BorderBrush="{Binding ImgBorderBrush}" BorderThickness="10,10,10,10">
                        <local:DamageDisplayBox 
                            x:Name="damageViewer"
                            Width="1920"
                            Height="800"
                            SourceImage="{Binding ImgSource}"
                            MouseWheel="DamageViewer_MouseWheel"
                            MouseMove="DamageViewer_MouseMove"
                            MouseLeftButtonDown="DamageViewer_MouseLeftButtonDown"
                            MouseLeftButtonUp="DamageViewer_MouseLeftButtonUp">
                            <local:DamageDisplayBox.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </local:DamageDisplayBox.RenderTransform>
                            
                            <hc:AdornerElement.Instance>
                                <hc:Magnifier
                                            HorizontalOffset="-16"
                                            Scale="2"
                                            VerticalOffset="-16"/>
                            </hc:AdornerElement.Instance>
                            </local:DamageDisplayBox>
                    </Border>
                </Viewbox>

                <StackPanel
                    Grid.Row="1"
                    Width="1400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Name="RuleInfo"
                        Width="400"
                        HorizontalAlignment="Left" />
                    <StackPanel
                        Width="1000"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="10,3"
                            HorizontalAlignment="Center"
                            Command="{Binding ModifyImgCommand}">
                            修改当前标记[Z]
                        </Button>
                        <ToggleButton
                            Width="130"
                            Height="40"
                            Margin="10,10"
                            Checked="ToggleButton_Checked"
                            Command="{Binding ShowAllBoxSelectedCommand}"
                            IsChecked="{Binding IsShowAllBoxSelected}">
                            显示标记[S]
                        </ToggleButton>
                        <Button Margin="10,10" Command="{Binding StartSnipasteCommand}">探头颜色展示</Button>
                        <ToggleButton
                            Margin="10"
                            Command="{Binding NoDamageCheckCommand}"
                            CommandParameter="鼠标点击"
                            IsEnabled="{Binding IsNoDamageBtnEnabled}"
                            Focusable="False"
                            Style="{StaticResource ToggleButtonSuccess}">
                            无伤[O]
                        </ToggleButton>
                        <ToggleButton
                            Margin="10"
                            Command="{Binding DamageCheckCommand}"
                            CommandParameter="鼠标点击"
                            IsEnabled="{Binding IsDamageBtnEnabled}"
                            Focusable="False"
                            Style="{StaticResource ToggleButtonDanger}"
                            >
                            疑似[P]
                        </ToggleButton>
                        <TextBlock
                            Margin="14,0,0,0"
                            FontWeight="DemiBold"
                            Text="备注:" />
                        <TextBox
                            Width="300"
                            Margin="3"
                            IsReadOnly="{Binding IsReadRemarkOnly}"
                            Text="{Binding DamageRemark}"
                            TextWrapping="WrapWithOverflow" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</hc:Window>
