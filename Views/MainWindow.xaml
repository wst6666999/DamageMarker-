<hc:Window
    x:Class="DamageMarker.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvs="clr-namespace:DamageMaker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DamageMaker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:DamageMaker.Models"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:vm="clr-namespace:DamageMarker.ViewModels"
    Title="探伤分析系统"
    Width="1920"
    Height="1000"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel,
                                     IsDesignTimeCreatable=True}"
    Icon="../Resources/Logo.png"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    FontFamily="Microsoft YaHei UI"
    mc:Ignorable="d">
    <Window.Resources>
        <cvs:AddOneConverter x:Key="AddOneConverter" />
        <cvs:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <cvs:NullToEmptyStringConverter x:Key="NullToEmptyStringConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Z" Command="{Binding ModifyImgCommand}" />
        <KeyBinding Key="O" Command="{Binding NoDamageCheckCommand}" />
        <KeyBinding Key="P" Command="{Binding DamageCheckCommand}" />
        <KeyBinding
            Key="S"
            Command="{Binding ShowAllBoxSelectedCommand}"
            CommandParameter="键盘触发" />
        <KeyBinding
            Key="W" Modifiers="Ctrl" Command="{Binding WinClosingCommand}"/>
    </Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding WinClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Background="#FFFFFF">
        <Grid Background="#FFFFFF">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="Scal" />
            </Grid.LayoutTransform>
            <Grid.Resources>
                <SolidColorBrush x:Key="ShanHePurpleBrush" Color="#2D9F4C" />
                <SolidColorBrush x:Key="ShanHePurpleDarkBrush" Color="#18833A" />
                <SolidColorBrush x:Key="ShanHePurpleLightBrush" Color="#BFE8CC" />
                <SolidColorBrush x:Key="ShanHeBlueBrush" Color="#3550DD" />
                <SolidColorBrush x:Key="ShanHeOrangeBrush" Color="#FF8000" />
                <SolidColorBrush x:Key="ShanHeOrangeBrush2" Color="#FBC115" />
                <SolidColorBrush x:Key="ShanHeRedBrush" Color="#DB3535" />
                <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
                    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                    <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    <Setter Property="Width" Value="130" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource ShanHeBlueBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ShanHeBlueBrush}" />
                </Style>
                <Style BasedOn="{StaticResource TextBlockDefaultPrimary}" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                </Style>
                <Style BasedOn="{StaticResource ToggleButtonPrimary}" TargetType="ToggleButton">
                    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                    <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    <Setter Property="Width" Value="130" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource ShanHeBlueBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ShanHeBlueBrush}" />
                </Style>

                <!-- 右侧“功能区 / 项目总览 / 单个总览”页签：选中蓝底白字，未选中白底蓝字 -->
                <Style x:Key="RightNavTabItemStyle" TargetType="TabItem">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinWidth" Value="88" />
                    <Setter Property="Margin" Value="0,0,2,0" />
                    <Setter Property="Padding" Value="14,5" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="#E6EBFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border
                                    x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3,3,0,0"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Margin="{TemplateBinding Padding}"
                                        ContentSource="Header"
                                        RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HeaderBorder" Property="Background" Value="#F1F4FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ShanHeBlueBrush}" />
                                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource ShanHeBlueBrush}" />
                                        <Setter TargetName="HeaderBorder" Property="Panel.ZIndex" Value="2" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ShanHeBlueBrush}" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="RightNavHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockDefaultPrimary}">
                    <Setter Property="FontSize" Value="{StaticResource SubHeadFontSize}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource ShanHeBlueBrush}" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="96" />
                <RowDefinition Height="58" />
                <RowDefinition Height="42" />
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="90" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Margin="18,14,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Image
                    Width="132"
                    Height="78"
                    Margin="0,0,18,0"
                    Source="../Resources/ShanHeZhongZhiLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="华文行楷,楷体"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{StaticResource ShanHePurpleBrush}">
                    北京山河众智技术有限公司
                </TextBlock>
            </StackPanel>
            <!-- 大标题：左端对齐到“复原”按钮文字中心附近，并略微放大 -->
            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="960"
                Height="92"
                Margin="580,8,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <TextBlock
                    Width="950"
                    VerticalAlignment="Center"
                    FontFamily="华文行楷,楷体"
                    FontSize="60"
                    FontWeight="Bold"
                    Foreground="{StaticResource ShanHePurpleBrush}"
                    Text="{Binding AppTitle}" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="3"
                Width="360"
                Height="126"
                Margin="0,70,28,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent" Grid.ColumnSpan="2">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox
                        FontSize="12"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        IsChecked="{Binding IsDetectionAsynChecked}"
                        IsEnabled="{Binding IsDetectionAsynEnable}">
                        探伤软件同步搜索
                    </CheckBox>
                    <TextBlock 
    Margin="30,0" 
    Text="6M"
    FontSize="12"
    FontWeight="Normal"
    VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is6MRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ShanHePurpleDarkBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock 
    Text="8C"
    FontSize="12"
    FontWeight="Normal"
    VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is8CRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ShanHePurpleDarkBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock 
Margin="30,0" 
Text="8Cnew"
FontSize="12"
FontWeight="Normal"
VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is8CnewRunning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ShanHePurpleDarkBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <hc:SearchBar
                    Width="276"
                    Height="32"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Right"
                    hc:InfoElement.Placeholder="格式为:300km200(中间以km或KM为分割)"
                    hc:InfoElement.Title="里程定位"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    Background="{StaticResource LightBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Command="{Binding SearchMileageCommand}"
                    CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
                    FontSize="12"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchMileageText}" TextChanged="SearchBar_TextChanged_1">
                    <hc:SearchBar.Effect>
                        <DropShadowEffect BlurRadius="2" Opacity="0.1" ShadowDepth="1"/>
                    </hc:SearchBar.Effect>
                </hc:SearchBar>
            </StackPanel>
            <hc:Drawer
                Name="DrawerLeft"
                Content="{Binding Setup}"
                Dock="Left"
                Effect="{StaticResource EffectShadow4}"
                ShowMode="Push" />
            <StackPanel
                Grid.Row="0"
                Width="0"
                HorizontalAlignment="Center" />
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Width="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="Visible" />
            <UniformGrid
                Grid.Row="1"
                Columns="3"
                Rows="0" Grid.ColumnSpan="2" Margin="387,2,5,14" Grid.RowSpan="2">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
            </UniformGrid>
            <GroupBox
                Grid.Row="3"
                Grid.RowSpan="1"
                Grid.Column="0"
                Header="{x:Null}"
                Background="#FFFFFF"
                Margin="0,0,22,10"
                hc:TitleElement.TitlePlacement="Top"
                Style="{StaticResource InputElementBaseStyle}">
                <GroupBox.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="5" Opacity="0.14"/>
                </GroupBox.Effect>
                <!-- 缩略图列表整体上移，使其距离里程区间约十几像素 -->
                <GroupBox.RenderTransform>
                    <TranslateTransform Y="-44"/>
                </GroupBox.RenderTransform>

                <GroupBox.Resources>
                    <!-- 自定义ListBox样式 -->
                    <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                    </Style>
                    <!-- 自定义ListBoxItem样式 -->
                    <Style x:Key="ModernListBoxItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border
                                                x:Name="InnerBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Margin="1"/>
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                            Margin="10"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2D9F4C"/>
                                            <Setter TargetName="Border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#2D9F4C" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#2196F3"/>
                                            <Setter TargetName="InnerBorder" Property="Background" Value="#E3F2FD"/>
                                            <Setter TargetName="Border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#2196F3" Opacity="0.3"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupBox.Resources>

                <ListBox
                        x:Name="ThumbnailList"
                        ItemsSource="{Binding ThumbnailImgInfos}"
                        SelectedIndex="{Binding SelectedIndex}"
                        SelectedItem="{Binding SelectedThumbnailImg}"
                        SelectionChanged="ThumbnailList_SelectionChanged"
                        Style="{StaticResource ModernListBoxStyle}"
                        ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        d:ItemsSource="{d:SampleData ItemCount=5}">

                    <ListBox.Resources>
                        <system:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">80</system:Double>
                    </ListBox.Resources>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding ImgSelectionChangedCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 美化文本显示 -->
                                <TextBlock
                                        Width="180"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#333333"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <TextBlock
                Width="115"  
                FontSize="20"  
                Text="图片展示区"
                FontWeight="Bold"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,2,0,0"
                Grid.Column="0" 
                Grid.Row="1"
                Height="40"
                Foreground="{StaticResource ShanHePurpleBrush}"  
                RenderTransformOrigin="0.5,0.5">

                <TextBlock.Effect>
                    <DropShadowEffect 
                        Color="#33000000" 
                        BlurRadius="4" 
                        ShadowDepth="1" 
                        Direction="315" 
                        Opacity="0.3"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform Y="2"/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
              
            </TextBlock>
            <StackPanel
                Grid.Column="0" 
                Grid.Row="1"
                Grid.RowSpan="2"
    Orientation="Horizontal"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Margin="130,0,0,0"
    Height="40">

                <TextBlock
        Text="里程区间"
        FontSize="17"
        FontWeight="SemiBold"
        Foreground="{StaticResource ShanHePurpleBrush}"
        VerticalAlignment="Center"
        Margin="0,0,8,0" Height="28" Width="78"/>

                <TextBox
        Width="120"
        TextWrapping="Wrap"
        Text="{Binding StartMileage, UpdateSourceTrigger=PropertyChanged}"
        hc:InfoElement.Placeholder="如：17KM 或 134KM307.8M"
        VerticalAlignment="Center"
        Style="{StaticResource TextBoxExtend}"/>

                <TextBlock
        Text=" - "
        FontSize="16"
        FontWeight="Bold"
        VerticalAlignment="Center"
        Margin="8,0,8,0"/>

                <TextBox
        Width="120"
        TextWrapping="Wrap"
        Text="{Binding EndMileage, UpdateSourceTrigger=PropertyChanged}"
        hc:InfoElement.Placeholder="如：18KM 或 135KM000M"
        VerticalAlignment="Center"
        Height="24"
        Style="{StaticResource TextBoxExtend}"/>

                <Button
        Content="搜索"
        Width="60"
        Height="28"
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding SearchMileageRangeCommand}"
        Background="{StaticResource ShanHePurpleBrush}"
        BorderBrush="{StaticResource ShanHePurpleBrush}"
        FontSize="12"/>

                <Button
        Content="复原"
        Width="60"
        Height="28"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding ResetMileageRangeFilterCommand}"
        Background="{StaticResource ShanHePurpleBrush}"
        BorderBrush="{StaticResource ShanHePurpleBrush}"
        FontSize="12"/>

                <!-- 当前图片文件夹：移动到“复原”按钮后面，并与按钮上下边缘对齐 -->
                <Grid
    Width="662"
    Height="40"
    Margin="18,0,0,0">

                    <TextBlock
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        FontSize="{StaticResource SubHeadFontSize}"
        FontStyle="Italic"
        Text="{Binding ImgFolderName}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding ImgFolderName}"
        Margin="0,0,0,2"/>
                </Grid>
            </StackPanel>
            <TabControl
                Grid.Row="2"
                Grid.RowSpan="5"
                Grid.Column="1"
                Margin="8,0,8,40"
                Background="Transparent">
                <TabControl.Resources>
                    <Style BasedOn="{StaticResource TabControlCapsuleSolid}" TargetType="TabControl">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Effect" Value="{StaticResource EffectShadow4}" />
                    </Style>
                </TabControl.Resources>
                <TabItem Style="{StaticResource RightNavTabItemStyle}">
                    <TabItem.Header>
                        <TextBlock
                            Style="{StaticResource RightNavHeaderTextStyle}"
                            Text="功能区" />
                    </TabItem.Header>
                    <StackPanel 
                        Background="Transparent" 
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Top">
                        <GroupBox
                            Height="353"
                            Width="332"
                            Style="{StaticResource GroupBoxTab.Small}"
                            Background="#FFFFFF"
                            Margin="0,10,0,20">
                            <GroupBox.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="9" Opacity="0.24"/>
                            </GroupBox.Effect>
                            <UniformGrid Columns="0" Rows="3">
                                <Menu
                                    Width="130"
                                    Height="40"
                                    BorderThickness="1"
                                    Effect="{StaticResource EffectShadow4}"
                                    Style="{StaticResource InputElementBaseStyle}"
                                    Background="{StaticResource ShanHeBlueBrush}">
                                    <MenuItem ItemsSource="{Binding MenuItems}">
                                        <MenuItem.Header>
                                            <Border 
                                                Width="111" 
                                                Height="38"
                                                Background="{StaticResource ShanHeBlueBrush}"
                                                CornerRadius="8"
                                                Padding="0"
                                                SnapsToDevicePixels="True">
                                                <TextBlock
                                                    Text="选择软件"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="16"
                                                    TextAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Top"/>
                                            </Border>
                                        </MenuItem.Header>
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem
                                                    Background="{StaticResource ShanHePurpleBrush}"
                                                    Command="{Binding Command}"
                                                    CommandParameter="{Binding CommandParameter}"
                                                    FontSize="16"
                                                    Foreground="White"
                                                    Header="{Binding Header}" />
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                </Menu>
                                <Button hc:IconElement.Geometry="{StaticResource FullScreenReturnGeometry}" Command="{Binding ScreenShotFuncCommand}">
                                    数据捕获
                                </Button>
                                <Button
                                    HorizontalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource AlignBottomGeometry}"
                                    Command="{Binding GetJsonResultCommand}"
                                    Background="{StaticResource ShanHePurpleBrush}"
                                    BorderBrush="{StaticResource ShanHePurpleBrush}"
                                    ToolTip="手动获取探伤数据">
                                    开始分析
                                </Button>
                            </UniformGrid>
                        </GroupBox>
                        <GroupBox
                            Grid.Row="4"
                            Height="337"
                            Margin="0,10"
                            Style="{StaticResource GroupBoxTab.Small}"
                            Background="#FFFFFF" Width="332">
                            <GroupBox.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="9" Opacity="0.24"/>
                            </GroupBox.Effect>
                            <UniformGrid Rows="4">
                                <ToggleButton
                                    Width="NaN"
                                    Height="40"
                                    Margin="96,0,96,0"
                                    hc:IconElement.Geometry="{StaticResource WindowsGeometry}"
                                    Effect="{StaticResource EffectShadow4}"
                                    FontSize="14"
                                    IsChecked="{Binding IsOpen, ElementName=DrawerLeft}" HorizontalAlignment="Stretch" Checked="ToggleButton_Checked_2">
                                    系统设置
                                </ToggleButton>
                                <Button
                                    hc:IconElement.Geometry="{StaticResource ClockGeometry}"
                                    Command="{Binding SelectedPathCommand}"
                                    ToolTip="打开以前的判伤集">
                                    历史回放
                                </Button>
                                <Button
                                    Width="130"
                                    Height="40"
                                    Margin="4"
                                    hc:IconSwitchElement.Geometry="{StaticResource EyeOpenGeometry}"
                                    Effect="{StaticResource EffectShadow4}"
                                    Command="{Binding HistorialPhotosCommand}"
                                    FontSize="14" Click="Button_Click">
                                    周期对比
                                </Button>
                                <ToggleButton
                                    Width="130"
                                    Height="40"
                                    Margin="4"
                                    Command="{Binding ExportReportCommand}"
                                    Background="{StaticResource ShanHePurpleBrush}"
                                    BorderBrush="{StaticResource ShanHePurpleBrush}"
                                    IsChecked="{Binding IsImporting}"
                                    Style="{StaticResource ToggleButtonLoadingPrimary}">
                                    导出报告
                                </ToggleButton>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Style="{StaticResource RightNavTabItemStyle}">
                    <TabItem.Header>
                        <TextBlock
